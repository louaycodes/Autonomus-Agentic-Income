# ========================================================
# CONFIGURATION CLUSTER AUTONOME 24/7 (VPS PRODUCTION)
# ========================================================

# Mode d'opération :
# true  = Mode simulation (dry-run sécurisé, profits comptabilisés sans engager de fonds)
# false = Mode live production réel
SIMULATION_MODE=true

# Clé Secrète Master de l'Opérateur (Louay) pour administrer l'API Gateway
MASTER_API_KEY=cluster_master_secret_change_this_key_2026

# Optionnel : Secret RapidAPI pour monétisation automatique sur la marketplace
RAPIDAPI_PROXY_SECRET=

# Moteur A (Ingestion Opportunités B2B)
SCOUT_INTERVAL_SECONDS=3600

# Moteur B (Arbitrage Polymarket)
MIN_SPREAD_THRESHOLD=0.08
MAX_TRADE_ALLOCATION_USD=20.0
POLYGON_RPC_URL=https://polygon-rpc.com

# Notifications & Ledger Telegram (Recommandé pour recevoir les gains quotidiens à 23h59)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Horaires de rapport quotidien (UTC)
DAILY_REPORT_HOUR_UTC=23
